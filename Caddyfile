# LIMS Application - Internal Caddy Proxy
# This Caddy runs inside Docker and routes traffic between services
# The host Caddy (on port 80/443) proxies lims.alshifalab.pk -> 127.0.0.1:8012 -> this container
# 
# Architecture:
#   Internet -> Host Caddy (ports 80/443) -> LIMS Proxy (port 8012) -> Backend/Frontend containers

# Global options (must be first)
{
    # Log level (debug, info, warn, error)
    log {
        level info
    }
    
    # Admin endpoint (disabled for security)
    admin off
    
    # Auto HTTPS disabled (handled by host Caddy)
    auto_https off
}

(common) {
     # Enable gzip compression
     encode gzip
     
     # Security headers
     header X-Content-Type-Options "nosniff"
     header X-Frame-Options "DENY"
     header X-XSS-Protection "1; mode=block"
     header Referrer-Policy "strict-origin-when-cross-origin"
     
     # Add HSTS header (HTTP Strict Transport Security) for production
     header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
     
     # Add timing headers for debugging
     header Server "LIMS/1.0"
 }
 
# HTTP configuration for Docker container (host Caddy handles HTTPS)
:80 {
    import common
    
    # Enable access logging
    log {
        output stdout
        level info
    }



     # Frontend - React SPA
     @frontend {
         not path /api/* /admin/* /static/* /media/* /health
     }
     handle @frontend {
         reverse_proxy frontend:80 {
             header_up Host {upstream_hostport}
         }
         # SPA Fallback - serve index.html for non-file routes
         try_files {path} /index.html
     }

     # Backend API
     handle /api/* {
         reverse_proxy backend:8000 {
             header_up Host {host}
             # Set to https since host Caddy handles HTTPS termination
             # This prevents Django SECURE_SSL_REDIRECT from causing redirect loops
             header_up X-Forwarded-Proto https
             header_up X-Forwarded-For {remote_host}
             header_up X-Real-IP {remote_host}
         }
     }

     # Django Admin
     handle /admin/* {
         reverse_proxy backend:8000 {
             header_up Host {host}
             # Set to https since host Caddy handles HTTPS termination
             # This prevents Django SECURE_SSL_REDIRECT from causing redirect loops
             header_up X-Forwarded-Proto https
             header_up X-Forwarded-For {remote_host}
             header_up X-Real-IP {remote_host}
         }
     }

     # Static files served directly (read-only volume from backend)
     handle_path /static/* {
         root * /srv/static
         file_server
     }

     # Media files served directly (read-only volume from backend)
     handle_path /media/* {
         root * /srv/media
         file_server
     }

     # Health check endpoint
     handle /health {
         respond "OK" 200
     }
 }
