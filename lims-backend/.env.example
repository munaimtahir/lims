# Copy to .env and adjust. Optional for local development.
# If DB_PASSWORD is unset, development settings use SQLite (manage.py migrate works without PostgreSQL).
# Or set USE_SQLITE=1 to force SQLite even when DB_PASSWORD is set.

# Force SQLite (development only)
# USE_SQLITE=1

# Database (only needed for PostgreSQL)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lims_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# For production you must set:
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=...
# DB_PASSWORD=...
