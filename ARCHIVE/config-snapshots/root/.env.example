# ============================================
# LIMS Environment Configuration Template
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# ============================================
# Application Settings
# ============================================
# Django secret key - Generate a secure key for production
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode - MUST be False in production
DEBUG=False

# ============================================
# Server Configuration
# ============================================
# Allowed hosts - CRITICAL: Include public IP and domains
ALLOWED_HOSTS=localhost,127.0.0.1,lims.alshifalab.pk

# Server name for Caddy reverse proxy
SERVER_NAME=lims.alshifalab.pk

# ============================================
# Database Configuration
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lims_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost,https://lims.alshifalab.pk
CORS_ALLOW_CREDENTIALS=True

# ============================================
# SSL/HTTPS Configuration
# ============================================
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=/api/v1

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
